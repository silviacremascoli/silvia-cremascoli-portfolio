---
import Layout from "../layouts/Layout.astro";
import Heading from "../components/Heading.astro";
import Paragraph from "../components/Paragraph.astro";
import { Button, Icon, Label, Input, Container, Row, Col } from "core-ui-library/vue";
---

<Layout
  title="Contact Silvia Cremascoli - Front-end Developer"
  description="Find here all the contact details to work with Silvia Cremascoli."
  page="contact"
>
  <Container size="full" queryable className="contact-details content-container cui-text-center cui-text-left-lg">
    <Heading level={1} class="cui-text-center cui-mt-lg">
      <span class="cui-block cui-mb-sm" aria-hidden="true">👋</span>
      <span>Let's get in touch!</span>
    </Heading>
    <Container size="full" queryable>
      <Row className="cui-mt-3xl">
        <Col lg={6} className="contact-form">
          <Heading level={2} class="cui-mb-3xl cui-text-center cui-text-left-lg">Write me a message</Heading>
          <form method="POST" name="contact" netlify data-astro-reload>
            <div class="cui-form-group">
              <Label color="primary" for="name-surname">Name and surname:&#8203;</Label>
              <Input type="text" class="cui-mt-sm" id="name-surname" name="name" required />
            </div>
            <div class="cui-form-group">
              <Label color="primary" for="email-address">Email address:&#8203;</Label>
              <Input type="email" class="cui-mt-sm" id="email-address" name="email" required />
            </div>
            <div class="cui-form-group">
              <Label color="primary" for="I-want-to">I want to:</Label>
              <select class="form-select cui-mt-sm" id="I-want-to" name="offer" required>
                <option>Discuss a role</option>
                <option>Collaborate on an open-source project</option>
                <option>Have a conversation</option>
              </select>
            </div>
            <div class="cui-form-group">
              <Label color="primary" for="your-message">Your message:</Label>
              <textarea class="form-control cui-mt-sm" id="your-message" rows="8" name="message" required
              ></textarea>
            </div>
            <Button type="submit" shape="pill" variant="outline" title="Send message">Send message</Button>
          </form>
        </Col>
        <Col lg={6} className="cui-flex cui-flex-col cui-justify-center">
          <div class="cui-text-center">
            <Heading level={2} class="cui-mb-3xl">Or find me here:</Heading>
            <Heading level={3} class="cui-flex cui-items-center cui-justify-center cui-gap-sm">
                <Icon icon="envelope-regular" size="2xl" ariaHidden={true} className="cui-mt-xs" />
                Email
            </Heading>
            <Paragraph>
              <a
                href="mailto:silcremascoli@gmail.com"
                class="contact-link">
                silcremascoli@gmail.com
              </a>
            </Paragraph>
            <Heading level={3} class="cui-flex cui-items-center cui-justify-center cui-gap-sm cui-mt-xl">
                <Icon icon="linkedin" size="2xl" ariaHidden={true} className="cui-mt-xs" />
                LinkedIn
            </Heading>
            <Paragraph>
              <a
                href="https://www.linkedin.com/in/silvia-cremascoli/"
                class="contact-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn profile of Silvia Cremascoli">@Silvia Cremascoli</a
              >
            </Paragraph>
          </div>
        </Col>
      </Row>
    </Container>
  </Container>
</Layout>
