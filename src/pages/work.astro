---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Curve from "../components/Curve.astro";
import ContactCta from "../components/ContactCta.astro";
import { projects } from "../data/projects.js";
import { skillGroups } from "../data/skills.js";
import { Button, Icon } from "core-ui-library/vue";

const images = import.meta.glob<ImageMetadata>("../assets/images/*.png", { eager: true, import: "default" });
---

<Layout
  title="My Front-End Development Projects - Silvia Cremascoli"
  description="Find here all the front-end development projects that Silvia Cremascoli has been working on."
  page="work"
>
  <div class="content-container container work">
    <div class="content cui-mt-0 cui-mb-0 text-center">
      <h1 class="cui-mb-3xl work-title">My latest projects</h1>
      <br />
      <div>
        <div class="row">
          {
            projects.map((project) => (
              <div class="col-md-6 cui-mb-3xl">
                <article class="project-card">
                  <Image
                    src={images[`../assets/images/${project.img}.png`]}
                    widths={[400, 800]}
                    sizes="(min-width: 768px) 45vw, 100vw"
                    alt={`Screenshot of ${project.alt}`}
                    class="project-image rounded cui-mb-xl"
                    id={project.id}
                    data-aos={project["aos-fade"]}
                    data-aos-duration="2000"
                    data-aos-easing="ease-in-sine"
                  />
                  <h2 class="project-title text-center cui-m-0">{project.name}</h2>
                  <p class="project-subtitle text-center text-muted cui-mt-sm">
                    Built with {project["built-with"]}
                  </p>
                  <div class="project-actions">
                    <Button
                      shape="pill"
                      size="medium"
                      href={project.link}
                      target="_blank"
                      ariaLabel={`Check it out: ${project.name}`}
                    >
                      Check it out
                    </Button>
                    <Button
                      shape="pill"
                      variant="outline"
                      href={project.github}
                      target="_blank"
                      aria-label={`See code on GitHub for ${project.name}`}
                    >
                      See code on GitHub
                    </Button>
                  </div>
                </article>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <Curve variant="green" />
  <div class="container skills">
    <div>
      <div class="row justify-content-center">
        {
          skillGroups.map((group) => (
            <div
              class="col-12 col-md-6 col-lg-4 text-center"
              data-aos="fade-up"
              data-aos-duration="2000"
              data-aos-easing="ease-in-sine"
            >
              <h2 class="cui-mb-xl">{group.title}</h2>
              {group.items.map((item) => (
                <p>
                  <Icon icon={item.icon} size="xl" color="text-light" ariaHidden={true} /> {item.name}
                </p>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <Curve variant="white" />
  <ContactCta />
</Layout>
