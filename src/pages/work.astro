---
import Layout from "../layouts/Layout.astro";
import Curve from "../components/Curve.astro";
import ContactCta from "../components/ContactCta.astro";
import { projects } from "../data/projects.js";
import { skillGroups } from "../data/skills.js";
---

<Layout
  title="My Front-End Development Projects - Silvia Cremascoli"
  description="Find here all the front-end development projects that Silvia Cremascoli has been working on."
  page="work"
>
  <div class="content-container container work">
    <div class="content mt-0 mb-0 text-center">
      <h1 class="mb-5 work-title">My latest projects</h1>
      <br />
      <div>
        <div class="row">
          {
            projects.map((project) => (
              <div class="col-md-6 mb-5">
                <img
                  src={`/assets/images/${project.img}.png`}
                  alt={`Screenshot of ${project.alt}`}
                  class="img-fluid rounded mb-3"
                  id={project.id}
                  data-aos={project["aos-fade"]}
                  data-aos-duration="2000"
                  data-aos-easing="ease-in-sine"
                />
                <h2 class="text-center m-0">{project.name}</h2>
                <p class="text-center text-muted">Built with {project["built-with"]}</p>
                <a
                  href={project.link}
                  class="btn btn-main"
                  target="_blank"
                  aria-label={`Check it out: ${project.name}`}>Check it out</a
                ><a
                  href={project.github}
                  class="btn btn-second github-project"
                  target="_blank"
                  aria-label={`See code on GitHub for ${project.name}`}>See code on GitHub</a
                >
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <Curve variant="green" />
  <div class="container skills">
    <div>
      <div class="row">
        {
          skillGroups.map((group) => (
            <div
              class="col-lg-4 text-center"
              data-aos="fade-up"
              data-aos-duration="2000"
              data-aos-easing="ease-in-sine"
            >
              <h2 class="mb-4">{group.title}</h2>
              {group.items.map((item) => (
                <p>
                  <i class={item.icon} aria-hidden="true" /> {item.name}
                </p>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <Curve variant="white" />
  <ContactCta />
</Layout>
