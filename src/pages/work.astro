---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Curve from "../components/Curve.astro";
import ContactCta from "../components/ContactCta.astro";
import Heading from "../components/Heading.astro";
import Paragraph from "../components/Paragraph.astro";
import Subtitle from "../components/Subtitle.astro";
import { projects } from "../data/projects.js";
import { skillGroups } from "../data/skills.js";
import { Button, Icon, Container, Row, Col } from "core-ui-library/vue";

const images = import.meta.glob<ImageMetadata>("../assets/images/*.png", { eager: true, import: "default" });
---

<Layout
  title="My Front-End Development Projects - Silvia Cremascoli"
  description="Find here all the front-end development projects that Silvia Cremascoli has been working on."
  page="work"
>
  <Container size="full" queryable className="content-container work cui-text-center cui-text-left-lg">
    <div class="cui-mt-0 cui-mb-0 cui-mx-2xl cui-text-center">
      <Heading level={1} class="cui-mb-3xl work-title">My latest projects</Heading>
      <br />
      <div>
        <Row>
          {
            projects.map((project) => (
              <Col md={6} className="cui-mb-3xl">
                <article class="project-card">
                  <Image
                    src={images[`../assets/images/${project.img}.png`]}
                    widths={[400, 800]}
                    sizes="(min-width: 768px) 45vw, 100vw"
                    alt={`Screenshot of ${project.alt}`}
                    class="project-image cui-rounded-md cui-mb-xl"
                    id={project.id}
                    data-aos={project["aos-fade"]}
                    data-aos-duration="2000"
                    data-aos-easing="ease-in-sine"
                  />
                  <Heading level={2} fontFamily="text" class="project-title cui-text-center cui-mb-sm">{project.name}</Heading>
                  <Subtitle class="project-subtitle cui-text-base cui-text-center cui-mt-xs cui-mb-lg">
                    Built with {project["built-with"]}
                  </Subtitle>
                  <div class="project-actions">
                    <Button
                      shape="pill"
                      size="medium"
                      href={project.link}
                      target="_blank"
                      ariaLabel={`Check it out: ${project.name}`}
                    >
                      Check it out
                    </Button>
                    <Button
                      shape="pill"
                      variant="outline"
                      href={project.github}
                      target="_blank"
                      aria-label={`See code on GitHub for ${project.name}`}
                    >
                      See code on GitHub
                    </Button>
                  </div>
                </article>
              </Col>
            ))
          }
        </Row>
      </div>
    </div>
  </Container>
  <Curve variant="green" />
  <div class="skills">
    <Container size="full" queryable className="content-container cui-text-center cui-text-left-lg">
      <div>
      <Row justifyContent="center" className="cui-mb-3xl">
        {
          skillGroups.map((group) => (
            <Col
              span={12}
              md={6}
              lg={4}
              className="cui-text-center cui-flex cui-flex-col cui-gap-xl"
              data-aos="fade-up"
              data-aos-duration="2000"
              data-aos-easing="ease-in-sine"
            >
              <Heading level={2}>{group.title}</Heading>
              {group.items.map((item) => (
                <Paragraph class="cui-text-lg cui-text-center" color="primary">
                  <Icon icon={item.icon} size="xl" ariaHidden={true} className="cui-mr-sm" />
                  <span>{item.name}</span>
                </Paragraph>
              ))}
            </Col>
          ))
        }
      </Row>
      </div>
    </Container>
  </div>
  <Curve variant="white" />
  <ContactCta />
</Layout>
