---
import { Button, Typography, Container } from "core-ui-library/vue";
---

<Container size="full">
  <section class="contact-cta">
    <div class="contact-box">
      <div>
        <Typography tag="h2" fontFamily={"heading"} weight={"bold"}>Do you like what you see?</Typography>
        <Typography tag="p">Let's work together!</Typography>
      </div>
      <div>
        <Button shape="pill" href="/contact" title="Contact Silvia Cremascoli">Contact me</Button>
      </div>
    </div>
  </section>
</Container>
